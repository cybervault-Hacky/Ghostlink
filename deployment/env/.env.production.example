# GhostLink Developer Portal — production environment (Phase 14)
# Every value below is REQUIRED; the portal fails closed on any missing value.
# Replace all CHANGE_ME placeholders. NEVER commit a real .env.

APP_ENV=production
# PostgreSQL only — SQLite is rejected in production (fail closed).
DATABASE_URL=postgresql://ghostlink_app:CHANGE_ME@127.0.0.1:5432/ghostlink
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT=15000
DB_IDLE_TIMEOUT=300

SESSION_SECRET=CHANGE_ME_long_random_session_secret
PORTAL_SECURE_COOKIES=true

EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=no-reply@example.com
EMAIL_SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=GhostLink <no-reply@example.com>

WEBAUTHN_RP_ID=portal.example.com
WEBAUTHN_ORIGIN=https://portal.example.com

# Multi-process deployments must use the distributed limiter (fail closed).
RATE_LIMIT_BACKEND=postgresql

ALLOWED_HOSTS=portal.example.com
TRUSTED_PROXIES=127.0.0.1
PORTAL_TRUSTED_PROXY=true

LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
DEPLOYMENT_VERSION=0.17.0

BACKUP_DIR=/var/lib/ghostlink/backups
BACKUP_RETENTION_COUNT=30
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=CHANGE_ME_long_backup_key

PUBLIC_BASE_URL=https://portal.example.com
