# GhostLink Developer Portal — environment configuration (Phase 11)
# Copy to .env for local development. NEVER commit a real .env with secrets.

# --- environment ---
# development | staging | production. Production fails closed when required
# values are missing or development conveniences are enabled.
APP_ENV=development

# --- database ---
# SQLite (default):        PORTAL_DB=portal.db
# PostgreSQL (production): DATABASE_URL=postgresql://user:pass@host:5432/ghostlink
PORTAL_DB=portal.db
# DATABASE_URL=

# --- server ---
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8788
# PORTAL_TRUSTED_PROXY=false   # set true when behind a reverse proxy that sets X-Forwarded-For

# --- session security ---
# Must be true when serving over HTTPS in production (config enforces this).
PORTAL_SECURE_COOKIES=false
# A high-entropy value; required (and never the dev default) in production.
# SESSION_SECRET=change-me-to-a-long-random-string

# --- email ---
# EMAIL_PROVIDER=dev  (records messages locally) or smtp (production).
EMAIL_PROVIDER=dev
# Production SMTP configuration (required when EMAIL_PROVIDER=smtp):
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=apikey
# EMAIL_SMTP_PASSWORD=secret
# EMAIL_FROM=no-reply@example.com

# --- WebAuthn (passkeys) ---
# Required in production (config enforces). No real values are committed here.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

# --- rate limits (optional overrides, testing) ---
# RATE_LIMIT_SIGN_IN=5:60
# RATE_LIMIT_SIGN_UP=3:3600
