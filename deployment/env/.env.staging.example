# GhostLink Developer Portal — staging environment (Phase 14)
# Staging is PostgreSQL-backed and fail-closed, but uses a staging SMTP sink.

APP_ENV=staging
DATABASE_URL=postgresql://ghostlink_app:CHANGE_ME@127.0.0.1:5432/ghostlink_staging
SESSION_SECRET=CHANGE_ME_long_random_secret
PORTAL_SECURE_COOKIES=true
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=staging@example.com
EMAIL_SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=GhostLink <no-reply@example.com>
WEBAUTHN_RP_ID=staging.example.com
WEBAUTHN_ORIGIN=https://staging.example.com
RATE_LIMIT_BACKEND=postgresql
ALLOWED_HOSTS=staging.example.com
TRUSTED_PROXIES=127.0.0.1
PORTAL_TRUSTED_PROXY=true
LOG_LEVEL=info
LOG_FORMAT=json
BACKUP_DIR=/var/lib/ghostlink/backups
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=CHANGE_ME
PUBLIC_BASE_URL=https://staging.example.com
