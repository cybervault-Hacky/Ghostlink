# GhostLink Developer Portal — environment configuration (Phase 10B)
# Copy to .env for local development. NEVER commit a real .env with secrets.

# --- database ---
# SQLite (default):        PORTAL_DB=portal.db
# PostgreSQL (production): PORTAL_DB=postgresql://user:pass@host:5432/ghostlink
PORTAL_DB=portal.db

# --- server ---
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8788

# --- session cookies ---
# Must be true when serving over HTTPS in production.
PORTAL_SECURE_COOKIES=false

# --- email ---
# Dev adapter records verification/reset messages in memory (logs them to
# the console) — for local testing only. A production transactional/email
# provider is configured here.
EMAIL_PROVIDER=dev

# --- WebAuthn (passkeys) ---
# Required production configuration (see docs/DEPLOYMENT.md). No real values
# are committed here.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=GhostLink Developer Portal
# WEBAUTHN_ORIGIN=https://your-domain.example

# --- signing / session secret (production) ---
# A high-entropy value; never commit a real one.
# SESSION_SECRET=change-me-to-a-long-random-string
