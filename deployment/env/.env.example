# GhostLink Developer Portal — environment template (Phase 14)
# Copy to your own .env (never commit a real .env). Values below are examples
# only. Placeholders like CHANGE_ME must be replaced.

# Environment: development | staging | production
APP_ENV=development

# --- Database ---
# development: SQLite file path. production/staging: PostgreSQL URL.
DATABASE_URL=portal.db
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT=15000
DB_IDLE_TIMEOUT=300

# --- Security ---
SESSION_SECRET=development-secret
PORTAL_SECURE_COOKIES=false

# --- WebAuthn ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Email ---
EMAIL_PROVIDER=dev
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=sender@example.com
# EMAIL_SMTP_PASSWORD=CHANGE_ME
# EMAIL_FROM=GhostLink <no-reply@example.com>

# --- Rate limiting ---
RATE_LIMIT_BACKEND=memory

# --- Proxy / hosts ---
# PORTAL_TRUSTED_PROXY=false
# TRUSTED_PROXIES=127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Observability ---
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
DEPLOYMENT_VERSION=0.16.0

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=30
BACKUP_ENCRYPT=false
# BACKUP_ENCRYPTION_KEY=CHANGE_ME (required when BACKUP_ENCRYPT=true)

# --- Public origin ---
# PUBLIC_BASE_URL=https://portal.example.com
