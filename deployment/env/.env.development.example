# GhostLink Developer Portal — development environment (Phase 14)
# Safe defaults for local development / Termux. Never use in production.

APP_ENV=development
DATABASE_URL=portal.db
SESSION_SECRET=development-secret
PORTAL_SECURE_COOKIES=false
EMAIL_PROVIDER=dev
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
RATE_LIMIT_BACKEND=memory
LOG_LEVEL=info
LOG_FORMAT=text
BACKUP_DIR=./backups
